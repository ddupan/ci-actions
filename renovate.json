{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "composite action 里带 renovate 注释的版本号",
      "managerFilePatterns": ["/(^|/)action\\.yml$/"],
      "matchStrings": ["_VERSION: (?<currentValue>\\S+)\\s+# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ]
}
