{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "composite action 里 docker run 的镜像",
      "managerFilePatterns": ["/(^|/)action\\.yml$/"],
      "matchStrings": ["_IMAGE: (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
